datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}



model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // "STUDENT" or "TEACHER"
  avatarColor  String   @default("#7c3aed")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student-Psychologist Association
  teacherId    String?
  teacher      User?    @relation("PsychologistStudents", fields: [teacherId], references: [id])
  students     User[]   @relation("PsychologistStudents")

  // Teacher relations
  lessons      Lesson[]
  quizzes      Quiz[]
  tests        Test[]

  // Student relations
  submissions         Submission[]
  testSubmissions     TestSubmission[]
  progress            LessonProgress[]
  mentalHealthResults MentalHealthResult[]
  testCompleted Boolean @default(false)
}

model Lesson {
  id String @id @default(cuid())
}

model Quiz {
  id String @id @default(cuid())
}

model Test {
  id String @id @default(cuid())
}

model Submission {
  id String @id @default(cuid())
}

model TestSubmission {
  id String @id @default(cuid())
}

model LessonProgress {
  id String @id @default(cuid())
}

model MentalHealthResult {
  id String @id @default(cuid())
}

