datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  username     String   @unique
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // "STUDENT" or "TEACHER"
  avatarColor  String   @default("#7c3aed")

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Student-Psychologist Association
  teacherId    String?
  teacher      User?    @relation("PsychologistStudents", fields: [teacherId], references: [id])
  students     User[]   @relation("PsychologistStudents")

  // Teacher relations
  lessons      Lesson[] @relation("TeacherLessons")
  quizzes      Quiz[]   @relation("TeacherQuizzes")
  tests        Test[]   @relation("TeacherTests")

  // Student relations
  submissions         Submission[]         @relation("StudentSubmissions")
  testSubmissions     TestSubmission[]     @relation("StudentTestSubmissions")
  progress            LessonProgress[]     @relation("StudentProgress")
  mentalHealthResults MentalHealthResult[] @relation("StudentMentalHealthResults")
  testCompleted       Boolean              @default(false)
}

model Lesson {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String   // "VIDEO" | "PDF" | "LINK"
  contentUrl  String
  order       Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User?    @relation("TeacherLessons", fields: [teacherId], references: [id])
  teacherId   String?

  quiz        Quiz?
  progress    LessonProgress[]
  testLessons TestLesson[]
}

model Quiz {
  id        String   @id @default(cuid())
  title     String
  questions String   // JSON-stringified
  timeLimit Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher   User?    @relation("TeacherQuizzes", fields: [teacherId], references: [id])
  teacherId String?

  lesson    Lesson   @relation(fields: [lessonId], references: [id])
  lessonId  String   @unique

  submissions Submission[]
}

model Test {
  id          String   @id @default(cuid())
  title       String
  description String?
  questions   String   // JSON-stringified

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User?    @relation("TeacherTests", fields: [teacherId], references: [id])
  teacherId   String?

  testLessons     TestLesson[]
  testSubmissions TestSubmission[]
}

model TestLesson {
  id       String @id @default(cuid())

  test     Test   @relation(fields: [testId], references: [id])
  testId   String

  lesson   Lesson @relation(fields: [lessonId], references: [id])
  lessonId String

  @@unique([testId, lessonId])
}

model Submission {
  id        String   @id @default(cuid())
  answers   String   // JSON-stringified
  score     Int
  maxScore  Int      @default(100)

  submittedAt DateTime @default(now())

  student   User   @relation("StudentSubmissions", fields: [studentId], references: [id])
  studentId String

  quiz      Quiz   @relation(fields: [quizId], references: [id])
  quizId    String

  @@unique([studentId, quizId])
}

model TestSubmission {
  id        String   @id @default(cuid())
  score     Int

  submittedAt DateTime @default(now())

  student   User   @relation("StudentTestSubmissions", fields: [studentId], references: [id])
  studentId String

  test      Test   @relation(fields: [testId], references: [id])
  testId    String

  @@unique([studentId, testId])
}

model LessonProgress {
  id        String   @id @default(cuid())
  status    String   @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETED"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student   User   @relation("StudentProgress", fields: [studentId], references: [id])
  studentId String

  lesson    Lesson @relation(fields: [lessonId], references: [id])
  lessonId  String

  @@unique([studentId, lessonId])
}

model MentalHealthResult {
  id        String   @id @default(cuid())
  score     Int
  answers   String   // JSON-stringified

  createdAt DateTime @default(now())

  student   User   @relation("StudentMentalHealthResults", fields: [studentId], references: [id])
  studentId String
}


